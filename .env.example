# AncoraMind — Environment Configuration
# Copy to .env and fill in your values

# ── LLM Provider ──────────────────────────────────
# Provider: openai | openrouter | openai-like
LLM_PROVIDER=openai

# ── OpenAI (provider=openai) ─────────────────────
# Agno auto-detects OPENAI_API_KEY from the environment
OPENAI_API_KEY=sk-your-api-key-here
# Default model: gpt-6-luna (cost-effective, tool-calling capable)
# Alternatives: gpt-4o, gpt-5.6-sol, gpt-5.6-terra
# LLM_MODEL=gpt-6-luna
# LLM_BASE_URL=  # Optional: proxy or compatible endpoint
# Hard safety cap per incoming message. Do not raise without evaluating cost/loop risk.
AGENT_TOOL_CALL_LIMIT=12

# ── OpenRouter (provider=openrouter) ─────────────
# Get key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# LLM_MODEL=anthropic/claude-3.5-sonnet
# OpenRouter base_url is automatic (https://openrouter.ai/api/v1)
# Models: openai/gpt-4o, anthropic/claude-3.5-sonnet,
#         google/gemini-2.0-flash, meta-llama/llama-3.3-70b-instruct, etc.

# ── OpenAI-compatible (provider=openai-like) ─────
# For Groq, Together, DeepSeek, Ollama, etc.
# Uses OPENAI_API_KEY + custom LLM_BASE_URL
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ── Governed public web search (BL-30 / specs-025) ───
# Disabled by default. Phase 1 sends only a minimized public query to Tavily;
# it never sends raw page content, personal data or conversation history.
# WEB_SEARCH_ENABLED=false
# TAVILY_API_KEY=tvly-your-key-here
# WEB_SEARCH_TIMEOUT_SECONDS=8
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_CACHE_TTL_SECONDS=300

# ── Telegram ──────────────────────────────────────
TELEGRAM_TOKEN=your-bot-token-from-botfather
# Defaults to production when absent (specs/023 T2). Keep this line for local
# development: it relaxes the webhook-secret check and AgentOS REST guarding.
APP_ENV=development
# Required whenever APP_ENV != development: without it, AgentOS's REST
# surface (/agents/*/runs, /sessions, /memories, /config, /eval-runs, ...)
# would be reachable without any credential (specs/023 T1). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# AGENT_OS_SECURITY_KEY=
# Required in production; skipped when APP_ENV=development
# TELEGRAM_WEBHOOK_SECRET_TOKEN=
# T3 ledger payload encryption. Required only when T4 enables durable admission.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this only in Railway/environment secrets; never commit or log it.
# TELEGRAM_PAYLOAD_ENCRYPTION_KEY=
# TELEGRAM_PAYLOAD_KEY_VERSION=1
# T4 durable admission rollout. Keep disabled until T5 processor is available.
# When true, all values below plus DB, webhook secret and Fernet key are required.
# TELEGRAM_ADMISSION_ENABLED=false
# TELEGRAM_BOT_ID=123456789
# TELEGRAM_ADMISSION_USER_BURST=5
# TELEGRAM_ADMISSION_BURST_WINDOW_SECONDS=10
# TELEGRAM_ADMISSION_USER_REQUESTS_PER_MINUTE=10
# TELEGRAM_ADMISSION_USER_REQUESTS_PER_HOUR=120
# TELEGRAM_ADMISSION_PENDING_GLOBAL=20
# TELEGRAM_ADMISSION_QUEUED_PER_CHAT=5
# T5 processor. Keep false until a controlled T4+T5 rollout is explicitly planned.
# TELEGRAM_PROCESSOR_ENABLED=false
# TELEGRAM_PROCESSOR_POLL_INTERVAL_SECONDS=1.0
# TELEGRAM_PROCESSOR_GLOBAL_CONCURRENCY=2
# BL-32: early "📄 Documento recibido, analizando…" ack for attachment-bearing
# interactions, sent before inference. Best-effort, outside the main outbox
# state machine — a failure here never blocks the main run.
# TELEGRAM_FAST_ACK_ENABLED=false
# BL-34: summarize the oldest ~40% of a session's own exchange ledger via a
# governed LLM call once its cumulative tokens (llm_usage_events) cross the
# threshold. Off by default; a failed compaction never aborts the run.
# CONTEXT_COMPACTION_ENABLED=false
# CONTEXT_COMPACTION_TOKEN_THRESHOLD=60000
# CONTEXT_COMPACTION_RATIO=0.4
# specs/023 T4.3-T4.4: Sí/No buttons + fixed proposal block before the Agent.
# Keep false until a T4.5 ProposalExecutor exists; it only changes delivery
# text/buttons today (claims commit, nothing executes yet).
# GOVERNED_CONSENT_ENABLED=false
# T8 tool-loop fingerprint HMAC. Optional: a dedicated key is derived from
# TELEGRAM_PAYLOAD_ENCRYPTION_KEY when omitted. Keep it only in Railway secrets.
# EXECUTION_BUDGET_FINGERPRINT_KEY=

# ── LiteLLM Gateway (T11, private / fail-closed) ─────
# Keep false until the private LiteLLM service and its exclusive PostgreSQL are
# healthy. When true, LLMAccess never falls back to direct OpenRouter/OpenAI.
# LITELLM_PROXY_ENABLED=false
# LITELLM_PROXY_BASE_URL=http://litellm.railway.internal:4000
# LITELLM_PROXY_VIRTUAL_KEY=sk-... # Railway secret created via /key/generate
# LITELLM_PROXY_DEFAULT_ROUTE=ancoramind-default-r1

# T12 per-key limits/budget for scripts/litellm_create_virtual_key.py.
# The Gateway enforces rpm_limit/tpm_limit/max_parallel_requests on the
# AncoraMind key; max_budget+budget_duration is an optional USD backstop.
# LITELLM_VIRTUAL_KEY_RPM=60
# LITELLM_VIRTUAL_KEY_TPM=250000
# LITELLM_VIRTUAL_KEY_MAX_PARALLEL_REQUESTS=4
# LITELLM_VIRTUAL_KEY_MAX_BUDGET_USD=
# LITELLM_VIRTUAL_KEY_BUDGET_DURATION=30d
# ADR-005: extend the key allowlist with aliases published at runtime.
# Prefer scripts/litellm_gateway_alias.py grant, which updates an existing key.
# LITELLM_VIRTUAL_KEY_ALIASES=ancoramind-default-r2

# T6 runtime config control plane. Disabled by default; do not expose the admin
# token in logs, Git or revision payloads.
# RUNTIME_CONFIG_ADMIN_ENABLED=false
# RUNTIME_CONFIG_ADMIN_TOKEN=<token-de-Railway>
# RUNTIME_CONFIG_ADMIN_ACTOR=<tu-usuario>
# Secret-free bootstrap default used before PostgreSQL initialization succeeds.
# RUNTIME_CONFIG_BOOTSTRAP_DEFAULT_ROUTE=ancoramind-default

# BL-24 governed Telegram pairing. Both flags are disabled by default. The
# protected admin API and private /pair redemption require the same Railway-only
# bearer above plus ANCORA_DATABASE_URL; invitation codes are HMACed with this
# independent pepper and must never be logged or committed.
# TELEGRAM_PAIRING_ADMIN_ENABLED=false
# TELEGRAM_PAIRING_ENABLED=false
# TELEGRAM_PAIRING_CODE_PEPPER=
# Pairing CLI actor is set only in the operator shell, never in Railway:
# RUNTIME_CONFIG_ADMIN_ACTOR=operator@example.com

# BL-43 operator web dashboard (/admin/dashboard). Disabled by default. Its
# token is intentionally separate from RUNTIME_CONFIG_ADMIN_TOKEN above: this
# one is read by browser JS, so a leak must never carry the CLI's
# runtime-config credential. Requires ANCORA_DATABASE_URL and
# TELEGRAM_PAIRING_CODE_PEPPER (reuses the pairing service directly).
# ADMIN_DASHBOARD_ENABLED=false
# ADMIN_DASHBOARD_TOKEN=<token-de-Railway-distinto-del-de-runtime-config>
# Enlaces estáticos opcionales mostrados en el dashboard; vacío = oculto.
# ADMIN_LINK_GRAFANA_URL=
# ADMIN_LINK_RAILWAY_URL=
# ADMIN_LINK_SUPABASE_URL=
# ADMIN_LINK_OPENROUTER_URL=
# ADMIN_LINK_LITELLM_URL=

# ── Observability (T10, metadata-only / fail-open) ────
# Agno product telemetry is always disabled by the application.
# Logs are JSON and never serialize positional log arguments, prompts, messages,
# document content, tool arguments/results or Telegram payloads.
# OBSERVABILITY_JSON_LOGS=true
# Private Railway Collector endpoint; empty disables OTLP export without
# affecting Telegram, tools or inference. Do not point this at Grafana directly.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://ancoramind-otel-collector.railway.internal:4317
# OTEL_EXPORTER_OTLP_INSECURE=true
# OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=3
# OTEL_EXPORT_INTERVAL_MILLIS=30000

# ── HTTP server ────────────────────────────────────
# Local development defaults: localhost:7777 with autoreload.
# Railway injects PORT automatically. Do not set PORT in Railway manually.
# AGENT_OS_HOST=localhost
# AGENT_OS_PORT=7777

# ── ngrok (local development) ────────────────────
# Not used on Railway: it provides a stable HTTPS domain.
# Start ngrok: ngrok http 7777
# Copy the https:// URL and paste here
NGROK_URL=https://your-subdomain.ngrok-free.app

# ── PostgreSQL (optional — Agno runtime) ─────────
# If not set, Agno defaults to SQLite in ./tmp/
#
# Local (Docker):
#   AGNO_DATABASE_URL=postgresql+psycopg://ancora:ancora@localhost:5432/ancoramind
#   ANCORA_DATABASE_URL=postgresql+asyncpg://ancora:ancora@localhost:5432/ancoramind
#
# Supabase (ADR-002) — Session pooler (IPv4, port 5432), NOT transaction (6543):
#   Copy from Supabase Dashboard → Connect → Session pooler
#   AGNO_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:PWD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
#   ANCORA_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:PWD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
AGNO_DATABASE_URL=postgresql+psycopg://ancora:ancora@localhost:5432/ancoramind
# ── AncoraMind Domain DB ─────────────────────────
ANCORA_DATABASE_URL=postgresql+asyncpg://ancora:ancora@localhost:5432/ancoramind

# ── Security ──────────────────────────────────────
# Comma-separated list of allowed Telegram user IDs
ALLOWED_TELEGRAM_USER_IDS=
MAX_FILE_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation

# ── Observability ─────────────────────────────────
LOG_LEVEL=INFO

# ── Document Storage ──────────────────────────────
# Backend: local | supabase (ADR-002)
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/documents

# ── Supabase Storage (backend=supabase) ──────────
# Dashboard → Settings → API. Service role key: server-side ONLY, never commit.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=ancora-documents

# ── Application ───────────────────────────────────
APP_DEBUG=false

# ── Reminder worker (BL-5 / ADR-003) ──────────────
# Fires pending reminders when due, notifying via Telegram sendMessage.
# Auto-gated: also requires ANCORA_DATABASE_URL and TELEGRAM_TOKEN.
# Outbound only — works without webhook (can run before BL-18 is closed).
REMINDER_WORKER_ENABLED=true
REMINDER_POLL_INTERVAL_SECONDS=60

# ── Calendar provider (BL-7) ──────────────────────
# "noop" (default, PostgreSQL-only) or "caldav" (a single shared CalDAV
# calendar collection — not per-user accounts). The provider push is
# best-effort: a failure never blocks the canonical PostgreSQL write.
# CALENDAR_PROVIDER=noop
# CALENDAR_CALDAV_BASE_URL=https://caldav.example.com/calendars/me/personal
# CALENDAR_CALDAV_USERNAME=
# CALENDAR_CALDAV_PASSWORD=