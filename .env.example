# AncoraMind — Environment Configuration
# Copy to .env and fill in your values

# ── LLM Provider ──────────────────────────────────
# Provider: openai | openrouter | openai-like
LLM_PROVIDER=openai

# ── OpenAI (provider=openai) ─────────────────────
# Agno auto-detects OPENAI_API_KEY from the environment
OPENAI_API_KEY=sk-your-api-key-here
# Default model: gpt-5.4-mini (cost-effective, tool-calling capable)
# Alternatives: gpt-4o, gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna
# LLM_MODEL=gpt-5.4-mini
# LLM_BASE_URL=  # Optional: proxy or compatible endpoint

# ── OpenRouter (provider=openrouter) ─────────────
# Get key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# LLM_MODEL=anthropic/claude-3.5-sonnet
# OpenRouter base_url is automatic (https://openrouter.ai/api/v1)
# Models: openai/gpt-4o, anthropic/claude-3.5-sonnet,
#         google/gemini-2.0-flash, meta-llama/llama-3.3-70b-instruct, etc.

# ── OpenAI-compatible (provider=openai-like) ─────
# For Groq, Together, DeepSeek, Ollama, etc.
# Uses OPENAI_API_KEY + custom LLM_BASE_URL
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ── Telegram ──────────────────────────────────────
TELEGRAM_TOKEN=your-bot-token-from-botfather
APP_ENV=development
# Required in production; skipped when APP_ENV=development
# TELEGRAM_WEBHOOK_SECRET_TOKEN=

# ── HTTP server ────────────────────────────────────
# Local development defaults: localhost:7777 with autoreload.
# Railway injects PORT automatically. Do not set PORT in Railway manually.
# AGENT_OS_HOST=localhost
# AGENT_OS_PORT=7777

# ── ngrok (local development) ────────────────────
# Not used on Railway: it provides a stable HTTPS domain.
# Start ngrok: ngrok http 7777
# Copy the https:// URL and paste here
NGROK_URL=https://your-subdomain.ngrok-free.app

# ── PostgreSQL (optional — Agno runtime) ─────────
# If not set, Agno defaults to SQLite in ./tmp/
#
# Local (Docker):
#   AGNO_DATABASE_URL=postgresql+psycopg://ancora:ancora@localhost:5432/ancoramind
#   ANCORA_DATABASE_URL=postgresql+asyncpg://ancora:ancora@localhost:5432/ancoramind
#
# Supabase (ADR-002) — Session pooler (IPv4, port 5432), NOT transaction (6543):
#   Copy from Supabase Dashboard → Connect → Session pooler
#   AGNO_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:PWD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
#   ANCORA_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:PWD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
AGNO_DATABASE_URL=postgresql+psycopg://ancora:ancora@localhost:5432/ancoramind
# ── AncoraMind Domain DB ─────────────────────────
ANCORA_DATABASE_URL=postgresql+asyncpg://ancora:ancora@localhost:5432/ancoramind

# ── Security ──────────────────────────────────────
# Comma-separated list of allowed Telegram user IDs
ALLOWED_TELEGRAM_USER_IDS=
MAX_FILE_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain

# ── Observability ─────────────────────────────────
LOG_LEVEL=INFO

# ── Document Storage ──────────────────────────────
# Backend: local | supabase (ADR-002)
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/documents

# ── Supabase Storage (backend=supabase) ──────────
# Dashboard → Settings → API. Service role key: server-side ONLY, never commit.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=ancora-documents

# ── Application ───────────────────────────────────
APP_DEBUG=false