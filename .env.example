# AncoraMind — Environment Configuration
# Copy to .env and fill in your values

# ── LLM Provider ──────────────────────────────────
# Provider: openai | openrouter | openai-like
LLM_PROVIDER=openai

# ── OpenAI (provider=openai) ─────────────────────
# Agno auto-detects OPENAI_API_KEY from the environment
OPENAI_API_KEY=sk-your-api-key-here
# Default model: gpt-5.4-mini (cost-effective, tool-calling capable)
# Alternatives: gpt-4o, gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna
# LLM_MODEL=gpt-5.4-mini
# LLM_BASE_URL=  # Optional: proxy or compatible endpoint
# Hard safety cap per incoming message. Do not raise without evaluating cost/loop risk.
AGENT_TOOL_CALL_LIMIT=8

# ── OpenRouter (provider=openrouter) ─────────────
# Get key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# LLM_MODEL=anthropic/claude-3.5-sonnet
# OpenRouter base_url is automatic (https://openrouter.ai/api/v1)
# Models: openai/gpt-4o, anthropic/claude-3.5-sonnet,
#         google/gemini-2.0-flash, meta-llama/llama-3.3-70b-instruct, etc.

# ── OpenAI-compatible (provider=openai-like) ─────
# For Groq, Together, DeepSeek, Ollama, etc.
# Uses OPENAI_API_KEY + custom LLM_BASE_URL
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ── Telegram ──────────────────────────────────────
TELEGRAM_TOKEN=your-bot-token-from-botfather
APP_ENV=development
# Required in production; skipped when APP_ENV=development
# TELEGRAM_WEBHOOK_SECRET_TOKEN=
# T3 ledger payload encryption. Required only when T4 enables durable admission.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this only in Railway/environment secrets; never commit or log it.
# TELEGRAM_PAYLOAD_ENCRYPTION_KEY=
# TELEGRAM_PAYLOAD_KEY_VERSION=1
# T4 durable admission rollout. Keep disabled until T5 processor is available.
# When true, all values below plus DB, webhook secret and Fernet key are required.
# TELEGRAM_ADMISSION_ENABLED=false
# TELEGRAM_BOT_ID=123456789
# TELEGRAM_ADMISSION_USER_BURST=5
# TELEGRAM_ADMISSION_BURST_WINDOW_SECONDS=10
# TELEGRAM_ADMISSION_USER_REQUESTS_PER_MINUTE=10
# TELEGRAM_ADMISSION_USER_REQUESTS_PER_HOUR=120
# TELEGRAM_ADMISSION_PENDING_GLOBAL=20
# TELEGRAM_ADMISSION_QUEUED_PER_CHAT=5
# T5 processor. Keep false until a controlled T4+T5 rollout is explicitly planned.
# TELEGRAM_PROCESSOR_ENABLED=false
# TELEGRAM_PROCESSOR_POLL_INTERVAL_SECONDS=1.0
# TELEGRAM_PROCESSOR_GLOBAL_CONCURRENCY=2

# T6 runtime config control plane. Disabled by default; do not expose the admin
# token in logs, Git or revision payloads.
# RUNTIME_CONFIG_ADMIN_ENABLED=false
# RUNTIME_CONFIG_ADMIN_TOKEN=
# Secret-free bootstrap default used before PostgreSQL initialization succeeds.
# RUNTIME_CONFIG_BOOTSTRAP_DEFAULT_ROUTE=ancoramind-default

# ── HTTP server ────────────────────────────────────
# Local development defaults: localhost:7777 with autoreload.
# Railway injects PORT automatically. Do not set PORT in Railway manually.
# AGENT_OS_HOST=localhost
# AGENT_OS_PORT=7777

# ── ngrok (local development) ────────────────────
# Not used on Railway: it provides a stable HTTPS domain.
# Start ngrok: ngrok http 7777
# Copy the https:// URL and paste here
NGROK_URL=https://your-subdomain.ngrok-free.app

# ── PostgreSQL (optional — Agno runtime) ─────────
# If not set, Agno defaults to SQLite in ./tmp/
#
# Local (Docker):
#   AGNO_DATABASE_URL=postgresql+psycopg://ancora:ancora@localhost:5432/ancoramind
#   ANCORA_DATABASE_URL=postgresql+asyncpg://ancora:ancora@localhost:5432/ancoramind
#
# Supabase (ADR-002) — Session pooler (IPv4, port 5432), NOT transaction (6543):
#   Copy from Supabase Dashboard → Connect → Session pooler
#   AGNO_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:PWD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
#   ANCORA_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:PWD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
AGNO_DATABASE_URL=postgresql+psycopg://ancora:ancora@localhost:5432/ancoramind
# ── AncoraMind Domain DB ─────────────────────────
ANCORA_DATABASE_URL=postgresql+asyncpg://ancora:ancora@localhost:5432/ancoramind

# ── Security ──────────────────────────────────────
# Comma-separated list of allowed Telegram user IDs
ALLOWED_TELEGRAM_USER_IDS=
MAX_FILE_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,text/plain

# ── Observability ─────────────────────────────────
LOG_LEVEL=INFO

# ── Document Storage ──────────────────────────────
# Backend: local | supabase (ADR-002)
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_PATH=./data/documents

# ── Supabase Storage (backend=supabase) ──────────
# Dashboard → Settings → API. Service role key: server-side ONLY, never commit.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=ancora-documents

# ── Application ───────────────────────────────────
APP_DEBUG=false

# ── Reminder worker (BL-5 / ADR-003) ──────────────
# Fires pending reminders when due, notifying via Telegram sendMessage.
# Auto-gated: also requires ANCORA_DATABASE_URL and TELEGRAM_TOKEN.
# Outbound only — works without webhook (can run before BL-18 is closed).
REMINDER_WORKER_ENABLED=true
REMINDER_POLL_INTERVAL_SECONDS=60