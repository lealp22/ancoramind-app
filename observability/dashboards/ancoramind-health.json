{
  "annotations": {"list": []},
  "description": "AncoraMind metadata-only operational health. Import after BL-23 Collector/Grafana rollout; select the Grafana Cloud OTLP metrics datasource.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "options": {"colorMode": "background", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "ancora_health_component", "refId": "A"}],
      "title": "Estado de componentes",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "options": {"colorMode": "value", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "ancora_admission_queue_depth", "refId": "A"}],
      "title": "Cola de admission",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "options": {"colorMode": "value", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "ancora_runtime_config_revision", "refId": "A"}],
      "title": "Revisión runtime activa",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "options": {"colorMode": "value", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "value_and_name"},
      "targets": [{"expr": "sum(increase(ancora_health_heartbeat_total[$__rate_interval])) by (ancora_health_component)", "refId": "A"}],
      "title": "Heartbeats recientes",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 5},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum(rate(ancora_telegram_admissions_total[$__rate_interval])) by (ancora_admission_status)", "legendFormat": "{{ancora_admission_status}}", "refId": "A"},
        {"expr": "sum(rate(ancora_telegram_deliveries_total[$__rate_interval])) by (ancora_delivery_status)", "legendFormat": "delivery {{ancora_delivery_status}}", "refId": "B"}
      ],
      "title": "Admission y deliveries",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ms"}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 5},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(ancora_agent_run_duration_milliseconds_bucket[$__rate_interval])) by (le))", "legendFormat": "agent p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(ancora_agent_run_duration_milliseconds_bucket[$__rate_interval])) by (le))", "legendFormat": "agent p95", "refId": "B"},
        {"expr": "histogram_quantile(0.95, sum(rate(ancora_telegram_delivery_duration_milliseconds_bucket[$__rate_interval])) by (le))", "legendFormat": "delivery p95", "refId": "C"}
      ],
      "title": "Latencia p50/p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum(increase(ancora_llm_calls_total[$__rate_interval])) by (ancora_status, gen_ai_request_model)", "legendFormat": "{{ancora_status}} {{gen_ai_request_model}}", "refId": "A"},
        {"expr": "sum(increase(ancora_execution_budget_exceeded_total[$__rate_interval])) by (ancora_budget_limit)", "legendFormat": "budget {{ancora_budget_limit}}", "refId": "B"}
      ],
      "title": "LLM y budgets",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "sum(increase(ancora_telegram_deliveries_total[$__rate_interval])) by (ancora_delivery_status)", "legendFormat": "{{ancora_delivery_status}}", "refId": "A"}],
      "title": "Resultado de deliveries Telegram",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [{"expr": "ancora_gateway_circuit_state", "legendFormat": "circuit {{ancora_circuit_state}}", "refId": "A"}],
      "title": "Estado del circuit breaker",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum(increase(ancora_llm_actual_cost_usd_total[$__rate_interval]))", "legendFormat": "coste USD", "refId": "A"},
        {"expr": "sum(increase(ancora_llm_total_tokens_total[$__rate_interval]))", "legendFormat": "tokens", "refId": "B"}
      ],
      "title": "Coste y tokens LLM",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum(increase(ancora_llm_calls_total{ancora_status=\"error\"}[$__rate_interval])) by (error_type)", "legendFormat": "LLM {{error_type}}", "refId": "A"},
        {"expr": "sum(increase(ancora_telegram_deliveries_total{ancora_delivery_status=\"error\"}[$__rate_interval])) by (error_type)", "legendFormat": "delivery {{error_type}}", "refId": "B"}
      ],
      "title": "Errores por tipo",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ancoramind", "health", "metadata-only", "specs-016"],
  "templating": {"list": [{"current": {}, "hide": 0, "includeAll": false, "label": "Datasource", "multi": false, "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource"}]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "AncoraMind · Salud operativa",
  "uid": "ancoramind-health",
  "version": 1
}