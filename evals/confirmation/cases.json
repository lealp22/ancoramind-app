{
  "schema_version": 1,
  "category": "confirmation",
  "cases": [
    {
      "id": "confirmation.execute_pending_vehicle_proposal",
      "description": "Un sí con una propuesta de vehículo pendiente ejecuta exactamente esa propuesta.",
      "input": "Sí, confirma.",
      "context": {
        "pending_proposal": {
          "id": "synthetic-vehicle-proposal",
          "tool_name": "create_vehicle"
        }
      },
      "expected": {
        "outcome": "confirm_pending_action",
        "required_tool": "execute_vehicle",
        "forbidden_tools": ["propose_vehicle"],
        "requires_user_confirmation": false
      },
      "tags": ["governance", "vehicle"]
    },
    {
      "id": "confirmation.execute_pending_reminder_proposal",
      "description": "Un sí con un recordatorio pendiente no crea una segunda propuesta.",
      "input": "Vale.",
      "context": {
        "pending_proposal": {
          "id": "synthetic-reminder-proposal",
          "tool_name": "create_reminder"
        }
      },
      "expected": {
        "outcome": "confirm_pending_action",
        "required_tool": "execute_reminder",
        "forbidden_tools": ["propose_reminder"],
        "requires_user_confirmation": false
      },
      "tags": ["governance", "reminders"]
    },
    {
      "id": "confirmation.yes_without_pending_action",
      "description": "Un sí sin propuesta pendiente no autoriza una mutación nueva.",
      "input": "Sí.",
      "context": {},
      "expected": {
        "outcome": "clarify",
        "forbidden_tools": ["execute_vehicle", "execute_reminder", "execute_calendar_event"],
        "requires_user_confirmation": false
      },
      "tags": ["governance", "authorization"]
    }
  ]
}