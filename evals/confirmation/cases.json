{
  "schema_version": 1,
  "category": "confirmation",
  "cases": [
    {
      "id": "confirmation.execute_pending_vehicle_proposal",
      "description": "Un sí con una propuesta de vehículo pendiente ejecuta exactamente esa propuesta.",
      "input": "Sí",
      "context": {
        "pending_proposal": {
          "id": "11111111-1111-1111-1111-111111111111",
          "tool_name": "register_vehicle"
        }
      },
      "expected": {
        "outcome": "confirm_pending_action",
        "required_tool": "register_vehicle",
        "forbidden_tools": ["propose_vehicle"],
        "requires_user_confirmation": false
      },
      "tags": ["governance", "vehicle"]
    },
    {
      "id": "confirmation.execute_pending_reminder_proposal",
