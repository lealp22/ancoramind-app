{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "evals/Dockerfile"
  },
  "deploy": {
    "startCommand": "python /app/scripts/eval_service.py",
    "restartPolicyType": "NEVER",
    "numReplicas": 1,
    "sleepApplication": false
  }
}